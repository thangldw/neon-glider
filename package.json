{
  "name": "hanzi-glider",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:fetch": "tsx scripts/fetch-hsk3.mts",
    "content:draft": "tsx scripts/draft-meanings.mts",
    "content:build": "tsx scripts/build-content.mts",
    "content:verify": "tsx scripts/verify-content.mts",
    "predeploy": "npm test && npm run content:verify && npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/three": "^0.185.4",
    "cheerio": "^1.2.0",
    "csv-parse": "^7.0.2",
    "gh-pages": "^6.3.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
